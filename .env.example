# ---- App ----
APP_ENV=development
SECRET_KEY=change-this-to-a-random-64-char-string
TOKEN_ENCRYPTION_KEY=generate-with-python-cryptography-fernet-generate-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440
FRONTEND_URL=http://localhost:3000
BACKEND_BASE_URL=http://localhost:8000

# ---- Database ----
DATABASE_URL=postgresql://growthpro:growthpro@localhost:5432/growthpro

# ---- Redis / Celery ----
REDIS_URL=redis://localhost:6379/0

# ---- Google OAuth (from Google Cloud Console > APIs & Services > Credentials) ----
# Enable: Search Console API, YouTube Data API v3, YouTube Analytics API
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/google/oauth/callback

# ---- AI ----
ANTHROPIC_API_KEY=your-anthropic-api-key

# ---- Meta (Facebook + Instagram) — developers.facebook.com/apps ----
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_REDIRECT_URI=http://localhost:8000/api/meta/oauth/callback

# ---- TikTok — developers.tiktok.com ----
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret
TIKTOK_REDIRECT_URI=http://localhost:8000/api/tiktok/oauth/callback

# ---- Stripe — dashboard.stripe.com/apikeys ----
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_SUCCESS_URL=http://localhost:3000/billing/success
STRIPE_CANCEL_URL=http://localhost:3000/billing/cancel

# ---- Production hardening ----
# Comma-separated list of domains allowed to call this API (your frontend's real domain(s))
ALLOWED_ORIGINS=http://localhost:3000,https://growthpro.growthpro.com
# sentry.io project DSN — leave blank locally, set in production for error tracking
SENTRY_DSN=
RATE_LIMIT_DEFAULT=100/minute

# ---- Email (resend.com — or swap email_service.py for SendGrid/SES) ----
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=GrowthPro <noreply@yourdomain.com>

# ---- DataForSEO (real keyword volume, SERP rank checks, backlink data) ----
# Sign up: https://app.dataforseo.com/register — pay-as-you-go, no monthly minimum
DATAFORSEO_LOGIN=your-dataforseo-login
DATAFORSEO_PASSWORD=your-dataforseo-password

# ---- Google Ads (Ad Center) — apply for a developer token first ----
# https://ads.google.com/aw/apicenter — approval is manual and can take days/weeks
GOOGLE_ADS_DEVELOPER_TOKEN=your-developer-token-once-approved

# ---- TikTok Ads (Marketing API) — business-api.tiktok.com ----
TIKTOK_ADS_APP_ID=your-tiktok-ads-app-id
TIKTOK_ADS_SECRET=your-tiktok-ads-secret

# ---- Media storage (video/photo uploads) — Cloudflare R2 recommended (S3-compatible, no egress fees) ----
# R2 setup: dash.cloudflare.com -> R2 -> Create bucket -> Manage R2 API tokens
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=growthpro-media
S3_ACCESS_KEY=your-r2-access-key
S3_SECRET_KEY=your-r2-secret-key
S3_REGION=auto
S3_PUBLIC_BASE_URL=https://media.yourdomain.com

# ---- Shopify (partners.shopify.com — create a custom or public app) ----
SHOPIFY_CLIENT_ID=your-shopify-app-client-id
SHOPIFY_CLIENT_SECRET=your-shopify-app-client-secret
SHOPIFY_REDIRECT_URI=http://localhost:8000/api/ecommerce/shopify/oauth/callback
